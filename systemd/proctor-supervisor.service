[Unit]
Description=proctor supervisor (deterministic job state machine; one active runner)
After=proctor-broker.service docker.service
Wants=proctor-broker.service

[Service]
Type=simple
User=proctor
Group=proctor
SupplementaryGroups=docker
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/proctor
ExecStart=/usr/bin/python3 /opt/proctor/proctor/supervisor.py
Restart=always
RestartSec=5
# Containers are owned by dockerd, not this cgroup: stopping the supervisor leaves runners
# alive so a restart can reattach to them.
KillMode=mixed
TimeoutStopSec=20
UMask=0002
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/proctor

[Install]
WantedBy=multi-user.target
