[Unit]
Description=swe-pilot runner network isolation (docker network swe-gw + INPUT filter)
After=docker.service network-online.target
Requires=docker.service
Before=swe-broker.service swe-supervisor.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/swe-pilot/bin/swe-firewall

[Install]
WantedBy=multi-user.target
