[Unit]
Description=proctor broker (model credential gateway with budget/quota enforcement, repo publisher, notifier)
After=proctor-firewall.service docker.service network-online.target
Requires=proctor-firewall.service

[Service]
Type=simple
User=root

Environment=PYTHONUNBUFFERED=1
# API keys for [credentials] = "env" (ANTHROPIC_API_KEY=..., OPENAI_API_KEY=...); root-only, mode 0600.
EnvironmentFile=-/etc/proctor/credentials.env
# For [credentials] = "hermes", install.sh --hermes adds a drop-in that runs this under Hermes' interpreter.
ExecStart=/usr/bin/python3 /opt/proctor/proctor/broker.py
Restart=always
RestartSec=5
UMask=0007
# Only one copy: systemd guarantees a single instance per unit.

[Install]
WantedBy=multi-user.target
