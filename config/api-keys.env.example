# Installed as /etc/proctor/credentials.env (root-only, mode 0600) and read by proctor-broker only.
# Workers never see these: they get a per-attempt gateway token instead.
# Used when [credentials] in settings.toml is "env" (the default). Restart the broker after editing:
#   sudo systemctl restart proctor-broker
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
