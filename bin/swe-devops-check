#!/usr/bin/env python3
"""DevOps watchdog for swe-pilot hosts (Hermes cron pre-run script; no model calls).

Runs a set of cheap health checks. Prints a report and, as its LAST line, the Hermes wake-gate
verdict {"wakeAgent": true|false}. The agent is woken only when a problem is NEW (not seen in the
previous run), has persisted for a re-alert interval, or a previous problem RECOVERED (so the agent
can post an all-clear). State: /var/lib/swe-pilot/devops/state.json.

Generic checks (every host): swe-pilot services, disk, memory, docker, gateway firewall chain,
supervisor stuck job, orchestrator gate errors. Project checks come from each registry project's
optional `devops.toml` next to project.toml:

    [[service]]           # systemd unit that must be active
    unit = "example.service"
    [[http]]              # URL that must answer 2xx within timeout
    name = "example-api"
    url = "http://127.0.0.1:8000/api/status"
    timeout = 15
    [[fresh]]             # file whose mtime must be recent
    name = "example log"
    path = "/var/log/example/app.log"
    max_age_minutes = 150
    [[log_errors]]        # recent lines of a log must not contain error patterns
    name = "example errors"
    path = "/var/log/example/app.log"
    since_marker = "^=== "
    patterns = ["Traceback", "update failed"]
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
import urllib.request
from pathlib import Path

ETC = Path(os.environ.get("SWE_ETC", "/etc/swe-pilot"))
STATE = Path("/var/lib/swe-pilot/devops/state.json")
REALERT_S = 6 * 3600
results = []  # (key, ok, detail)


def check(key, ok, detail=""):
    results.append((key, bool(ok), detail))


def sh(*cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:  # noqa: BLE001
        return 99, str(e)


def unit_active(unit):
    rc, out = sh("systemctl", "is-active", unit)
    check(f"service:{unit}", out == "active", out)


# ---- generic
for u in ("swe-broker", "swe-supervisor", "swe-firewall", "docker"):
    unit_active(u)
du = shutil.disk_usage("/")
check("disk:/", du.free / du.total > 0.10, f"{du.free / 2**30:.1f} GiB free ({du.free / du.total:.0%})")
mem = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo") if l.split(":")[0] in ("MemTotal", "MemAvailable")}
check("memory", mem["MemAvailable"] / mem["MemTotal"] > 0.08, f"{mem['MemAvailable'] // 1024} MiB available")
rc, out = sh("iptables", "-S", "SWE-GW-IN")
check("firewall:SWE-GW-IN", rc == 0 and out.count("\n") >= 2, "chain present" if rc == 0 else out[:200])
rc, out = sh("/usr/local/bin/swe", "--json", "list", "-n", "5")
try:
    jobs = json.loads(out) if rc == 0 else []
    stuck = [j for j in jobs if j["state"] not in ("ready_for_review", "failed", "needs_input", "blocked_environment",
                                                   "blocked_budget", "cancelled", "interrupted", "queued", "waiting_quota")
             and time.time() - (j.get("updated_at") or j.get("created_at") or time.time()) > 90 * 60]
    check("swe:stuck-job", not stuck, ", ".join(f"{j['id']} {j['state']}" for j in stuck) or "none")
except Exception as e:  # noqa: BLE001
    check("swe:list", False, f"swe list failed: {e} {out[:200]}")
gl = Path(os.environ["SWE_ORCH_GATE_LOG"]) if os.environ.get("SWE_ORCH_GATE_LOG") else None
if gl and gl.exists():
    check("orchestrator:gate-log", time.time() - gl.stat().st_mtime < 3600, f"last gate {int((time.time() - gl.stat().st_mtime) / 60)} min ago")

# ---- per-project
for pdir in sorted((ETC / "projects").glob("*/devops.toml")):
    proj = pdir.parent.name
    try:
        cfg = tomllib.loads(pdir.read_text())
    except Exception as e:  # noqa: BLE001
        check(f"{proj}:devops.toml", False, str(e))
        continue
    for s in cfg.get("service", []):
        rc, out = sh("systemctl", "is-active", s["unit"])
        check(f"{proj}:service:{s['unit']}", out == "active", out)
    for h in cfg.get("http", []):
        t0 = time.time()
        try:
            with urllib.request.urlopen(h["url"], timeout=h.get("timeout", 15)) as r:
                ok = 200 <= r.status < 300
                det = f"{r.status} in {time.time() - t0:.1f}s"
        except Exception as e:  # noqa: BLE001
            ok, det = False, f"{type(e).__name__}: {str(e)[:150]}"
        check(f"{proj}:http:{h['name']}", ok, det)
    for f in cfg.get("fresh", []):
        p = Path(f["path"])
        if not p.exists():
            check(f"{proj}:fresh:{f['name']}", False, f"missing {p}")
            continue
        age = (time.time() - p.stat().st_mtime) / 60
        check(f"{proj}:fresh:{f['name']}", age <= f["max_age_minutes"], f"{age:.0f} min old (max {f['max_age_minutes']})")
    for lg in cfg.get("log_errors", []):
        p = Path(lg["path"])
        if not p.exists():
            continue
        with open(p, "rb") as fh:
            fh.seek(max(0, p.stat().st_size - 200_000))
            tail = fh.read().decode("utf-8", "replace").splitlines()
        marker = re.compile(lg.get("since_marker", "^$"))
        idx = max([i for i, line in enumerate(tail) if marker.search(line)] or [0])
        last = tail[idx:]
        hits = [line for line in last if any(re.search(pt, line) for pt in lg["patterns"])]
        check(f"{proj}:log:{lg['name']}", not hits, (hits[0][:200] + (f" (+{len(hits) - 1} more)" if len(hits) > 1 else "")) if hits else "clean")

# ---- compare with previous state and decide
STATE.parent.mkdir(parents=True, exist_ok=True)
prev = json.loads(STATE.read_text()) if STATE.exists() else {"failing": {}}
now = time.time()
failing = {k: d for k, ok, d in results if not ok}
new = [k for k in failing if k not in prev["failing"]]
recovered = [k for k in prev["failing"] if k not in failing]
stale = [k for k in failing if k in prev["failing"] and now - prev["failing"][k]["alerted"] > REALERT_S]
state = {"failing": {k: {"since": prev["failing"].get(k, {}).get("since", now),
                         "alerted": now if (k in new or k in stale) else prev["failing"][k]["alerted"],
                         "detail": failing[k]} for k in failing}, "checked": now}
STATE.write_text(json.dumps(state, indent=1))

print(f"=== devops watchdog {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}: "
      f"{len(results)} checks, {len(failing)} failing, {len(new)} new, {len(recovered)} recovered")
for k, ok, d in results:
    if not ok:
        since = state["failing"][k]["since"]
        tag = "NEW" if k in new else ("STILL" if k in stale else "known")
        print(f"FAIL [{tag}] {k}: {d} (since {time.strftime('%H:%MZ', time.gmtime(since))})")
for k in recovered:
    print(f"RECOVERED {k} (was: {prev['failing'][k]['detail']})")
print(f"ok: {sum(1 for _, ok, _ in results if ok)} checks")
print(json.dumps({"wakeAgent": bool(new or recovered or stale)}))
